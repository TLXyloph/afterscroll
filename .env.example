# Copy to .env and fill in. Never commit the filled file.
# In production these are set as Cloudflare secrets (wrangler secret put NAME),
# except the non-secret toggles which live in wrangler.jsonc [vars].

# Public base URL of the app (used for OAuth redirect URIs)
APP_URL=http://localhost:3000

# X (Twitter) OAuth 2.0 app — Client ID/Secret from the "OAuth 2.0" section
X_CLIENT_ID=
X_CLIENT_SECRET=

# Google Cloud OAuth client (Calendar + YouTube scopes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude via Azure/Microsoft Foundry — resource name (or full endpoint URL) + key
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_RESOURCE=

# Stripe (test mode: sk_test_… / whsec_…). Leave blank to keep billing dormant.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin key guarding POST /api/admin/promo — must be >= 24 chars (high entropy)
ADMIN_KEY=

# Billing + cost guardrails (non-secret toggles; mirror in wrangler.jsonc [vars])
BILLING_ENFORCED=false
SPEND_CAP_USD_PER_DAY=2.00
GLOBAL_SPEND_CAP_USD_PER_DAY=100.00

# Dev-only: use seed/bookmarks.json instead of the live X API
SEED_MODE=false

# Local dev overrides (optional)
# DB_FILE=.data/dev.db
